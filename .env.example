# DeepSocial — local/staging environment example.
# Copy to .env.local and fill values privately. Never commit real secrets.
# Neon project: patient-leaf-98302482; branch: production; database: deepsocial.
# Copy the POOLED connection string for database "deepsocial" from Neon Connect.
DATABASE_URL=

# Better Auth: use a randomly generated secret (at least 32 characters).
BETTER_AUTH_SECRET=
# The actual origin of the deployed app (https://...). Do not include /api/auth.
BETTER_AUTH_URL=

# Optional Google sign-in (both required to enable Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Temporary Supabase Storage dependency, until migrated to UploadThing.
# The service role key is SERVER-ONLY; never prefix it with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional scheduled-post publishing endpoint.
CRON_SECRET=
